# Copy this file to .env and fill in your values. .env is ignored by Git.

# Account identifier in ORGNAME-ACCOUNTNAME form (Snowsight > account menu > View account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# snowflake_jwt = key-pair authentication (recommended for scripts; see README)
# snowflake     = password, or a programmatic access token, in SNOWFLAKE_PASSWORD
#                 (a plain password won't work once the user is enrolled in MFA)
SNOWFLAKE_AUTHENTICATOR=snowflake_jwt
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSWORD=
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=ENGINE_ENGINEER
SNOWFLAKE_WAREHOUSE=ENGINE_WH
SNOWFLAKE_DATABASE=ENGINE_ANALYTICS
