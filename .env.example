# Copy this file to .env and fill in your values. .env is ignored by Git.

# Account identifier, e.g. orgname-accountname or abc12345.ca-central-1.aws
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# externalbrowser = sign in through your browser (works with MFA)
# snowflake       = user name and password (set SNOWFLAKE_PASSWORD)
# snowflake_jwt   = key-pair authentication (set SNOWFLAKE_PRIVATE_KEY_FILE)
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_FILE=

SNOWFLAKE_ROLE=ENGINE_ENGINEER
SNOWFLAKE_WAREHOUSE=ENGINE_WH
SNOWFLAKE_DATABASE=ENGINE_ANALYTICS
