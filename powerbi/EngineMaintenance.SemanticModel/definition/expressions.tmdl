expression SnowflakeServer = "xy12345.ca-central-1.aws.snowflakecomputing.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: eac28a25-81c2-5fb3-888d-14419fbd3cdd

	annotation PBI_ResultType = Text

expression fnLoadTable =
		(tableName as text) as table =>
		let
		    FromCsv = () =>
		        let
		            Raw = Csv.Document(File.Contents(DataFolder & tableName & ".csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		            Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true])
		        in
		            Promoted,
		    FromSnowflake = () =>
		        let
		            Source = Snowflake.Databases(SnowflakeServer, "ENGINE_WH", [Role = "ENGINE_ANALYST"]),
		            Database = Source{[Name = "ENGINE_ANALYTICS", Kind = "Database"]}[Data],
		            Schema = Database{[Name = "ANALYTICS", Kind = "Schema"]}[Data],
		            Result = Schema{[Name = tableName]}[Data]
		        in
		            Result,
		    // Same column types for both sources (Snowflake returns whole numbers as decimals)
		    Source = if SourceMode = "Snowflake" then FromSnowflake() else FromCsv(),
		    Columns = Table.ColumnNames(Source),
		    TextColumns = {"ENGINE_KEY", "ENGINE_SERIAL_NUMBER", "FLEET_ID", "DATASET_SPLIT", "ENGINE_LIFECYCLE", "HEALTH_STATUS", "MODEL_NAME", "MODEL_VERSION", "FLEET_NAME", "OPERATING_CONDITION_DESC", "FAULT_MODES", "SENSOR_SYMBOL", "SENSOR_DESCRIPTION", "UNIT_OF_MEASURE", "CHECK_NAME", "CATEGORY", "STATUS"},
		    WholeNumberColumns = {"UNIT_NUMBER", "CYCLE", "CURRENT_CYCLE", "ACTUAL_RUL", "SENSOR_ID", "OPERATING_CONDITIONS", "FAULT_MODE_COUNT", "FAILING_ROWS"},
		    LogicalColumns = {"USED_IN_BASELINE_MODEL"},
		    DateTimeColumns = {"CHECKED_AT", "FIRST_LOADED_AT", "LOADED_AT"},
		    DecimalColumns = List.Difference(Columns, TextColumns & WholeNumberColumns & LogicalColumns & DateTimeColumns),
		    TypeList =
		        List.Transform(List.Intersect({Columns, TextColumns}), each {_, type text})
		        & List.Transform(List.Intersect({Columns, WholeNumberColumns}), each {_, Int64.Type})
		        & List.Transform(List.Intersect({Columns, LogicalColumns}), each {_, type logical})
		        & List.Transform(List.Intersect({Columns, DateTimeColumns}), each {_, type datetime})
		        & List.Transform(DecimalColumns, each {_, type number}),
		    Typed = Table.TransformColumnTypes(Source, TypeList, "en-US")
		in
		    Typed
	lineageTag: d3dfbef2-f139-5719-ac61-548627b81d2f

	annotation PBI_ResultType = Function

