model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SourceMode", "DataFolder", "SnowflakeServer", "fnLoadTable", "_Measures", "Fleet", "Engine", "Sensor", "Engine Cycles", "Engine Health", "Sensor Readings", "Data Quality"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Fleet
ref table Engine
ref table Sensor
ref table 'Engine Cycles'
ref table 'Engine Health'
ref table 'Sensor Readings'
ref table 'Data Quality'

