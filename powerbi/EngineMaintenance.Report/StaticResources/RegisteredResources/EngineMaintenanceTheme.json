{
  "name": "Engine Maintenance",
  "dataColors": ["#1F6E8C", "#E07A1F", "#2E9E6A", "#C0392B", "#6C5B9E", "#8AA1B1", "#D4A017", "#3B4B5C"],
  "background": "#FFFFFF",
  "foreground": "#1B2B3A",
  "tableAccent": "#1F6E8C",
  "good": "#2E9E6A",
  "neutral": "#E0A31F",
  "bad": "#C0392B",
  "minimum": "#2E9E6A",
  "center": "#E0A31F",
  "maximum": "#C0392B",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1B2B3A" },
    "title": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1B2B3A" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1B2B3A" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#5B6B7D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 11,
          "fontColor": { "solid": { "color": "#1B2B3A" } }
        }],
        "categoryAxis": [{
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#5B6B7D" } },
          "titleColor": { "solid": { "color": "#5B6B7D" } }
        }],
        "valueAxis": [{
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#5B6B7D" } },
          "titleColor": { "solid": { "color": "#5B6B7D" } },
          "gridlineColor": { "solid": { "color": "#E6EBF1" } }
        }],
        "legend": [{
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#3E4E60" } }
        }]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [{ "show": false }],
        "title": [{ "fontSize": 9, "fontColor": { "solid": { "color": "#5B6B7D" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E6EBF1" } },
          "rowPadding": 5
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#1B2B3A" } },
          "backColor": { "solid": { "color": "#F1F4F8" } },
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#1B2B3A" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#1B2B3A" } },
          "backColorSecondary": { "solid": { "color": "#FAFBFC" } }
        }]
      }
    },
    "page": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#E8EDF2" } } }]
      }
    }
  }
}
